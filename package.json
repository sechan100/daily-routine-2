{
  "name": "daily-routine-obsidian-plugin",
  "version": "1.0.9",
  "description": "Daily Routine — an Obsidian plugin for tracking recurring tasks and daily habits",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs dev",
    "test": "jest",
    "lint": "eslint src package.json",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "local": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs local",
    "version": "node version-bump.mjs && git add manifest.json versions.json"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "habit-tracker",
    "routine",
    "recurring-tasks"
  ],
  "author": "sechan100",
  "license": "MIT",
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^16.11.6",
    "@types/react": "^18.3.8",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "obsidian": "latest",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^6.1.6",
    "@mui/system": "^6.4.3",
    "@popperjs/core": "^2.11.8",
    "clsx": "^2.1.1",
    "dedent": "^1.5.3",
    "dnd-core": "^16.0.1",
    "es-toolkit": "^1.51.0",
    "mitt": "^3.0.1",
    "neverthrow": "^8.1.1",
    "react": "^18.3.1",
    "react-bem-helper": "^1.4.1",
    "react-calendar": "^5.0.0",
    "react-dnd": "^16.0.1",
    "react-dnd-html5-backend": "^16.0.1",
    "react-dnd-multi-backend": "^8.0.3",
    "react-dnd-preview": "^8.1.2",
    "react-dnd-touch-backend": "^16.0.1",
    "react-dom": "^18.3.1",
    "react-transition-group": "^4.4.5",
    "swiper": "^12.2.0",
    "zustand": "^5.0.0-rc.2"
  },
  "overrides": {
    "anymatch": {
      "picomatch": "^4.0.5"
    }
  }
}
